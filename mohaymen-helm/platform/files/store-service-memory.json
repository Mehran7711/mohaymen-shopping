{
  "spec": {
    "template": {
      "spec": {
        "containers": [
          {
            "name": "store-service",
            "env": [
              {
                "name": "JAVA_TOOL_OPTIONS",
                "value": "-XX:MaxRAMPercentage=70.0"
              }
            ],
            "resources": {
              "requests": {
                "memory": "768Mi"
              },
              "limits": {
                "memory": "1536Mi"
              }
            }
          }
        ]
      }
    }
  }
}
