{
  "uid": "spring-metrics",
  "title": "Spring services",
  "tags": ["metrics", "spring"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(up{job=\"spring-boot\"}, application)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Targets up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"spring-boot\", application=~\"$application\"})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{application}}",
          "expr": "process_cpu_usage{job=\"spring-boot\", application=~\"$application\"}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{application}}",
          "expr": "sum by (application) (jvm_memory_used_bytes{job=\"spring-boot\", application=~\"$application\", area=\"heap\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP rate",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{application}} {{uri}} {{status}}",
          "expr": "sum by (application, uri, status) (rate(http_server_requests_seconds_count{job=\"spring-boot\", application=~\"$application\"}[1m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP p95 latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "{{application}} {{uri}}",
          "expr": "histogram_quantile(0.95, sum by (le, application, uri) (rate(http_server_requests_seconds_bucket{job=\"spring-boot\", application=~\"$application\"}[1m])))"
        }
      ]
    }
  ]
}
